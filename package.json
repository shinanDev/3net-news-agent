{
  "name": "3net-news-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly news agent: fetch, pre-filter, check memory, rate with reasons, render a newsletter draft.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "run": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p vendor/hmem/tsconfig.json",
    "conformance": "tsx scripts/conformance.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
