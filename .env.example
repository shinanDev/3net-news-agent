# Copy to .env and fill in locally. Never commit .env.
# See CLAUDE.md, section "Configuration", for what each variable means.

# News source: stub (default) or zetaris
SOURCE=

# Zetaris (read and query layer)
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_ROW_LIMIT=

# Prefilter and rating limits (empty = defaults, see CLAUDE.md)
PREFILTER_NEW_DAYS=
PREFILTER_HORIZON_MONTHS=
RATE_MAX_ITEMS=

# Rating: stub (default) or nightshift; language and profile path (empty = defaults)
RATER=
RATING_LANGUAGE=
RATING_PROFILE=
RATING_STRICT_MODEL=

# Already reported: none (default) or hmem; folder, threshold, remember (true/false)
MEMORY=
MEMORY_DIR=
MEMORY_SIMILARITY_THRESHOLD=
MEMORY_MARK=

# Maintenance windows from an ICS calendar (empty path = off; file stays under data/)
DATEV_MAINTENANCE_ICS_PATH=
DATEV_MAINTENANCE_WEEKDAY=
DATEV_MAINTENANCE_START=
DATEV_MAINTENANCE_END=
DATEV_MAINTENANCE_TZ=
DATEV_MAINTENANCE_LOOKAHEAD_DAYS=

# Run report: html (default, file in data/out/) or console
OUTPUT=

# Meterless Nightshift (OpenAI-compatible runtime)
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=
METERLESS_APP=
METERLESS_SCOPE=
NIGHTSHIFT_TIMEOUT_MS=
